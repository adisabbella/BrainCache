# BrainCache Server Environment Variables
# Copy this file to .env and adjust for your local setup.
# NEVER commit .env to version control.

# Server port
PORT=3001

# Environment (development | production)
NODE_ENV=development

# Frontend URL (used for CORS — must match where the frontend runs)
CLIENT_URL=http://localhost:5173

# MongoDB connection URI
MONGODB_URI=mongodb://localhost:27017/braincache

# JWT signing secret — use a long, random string in production
JWT_SECRET=replace-with-a-long-random-secret

# JWT expiration (e.g. 7d, 24h, 3600)
JWT_EXPIRES_IN=7d